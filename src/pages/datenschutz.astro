---
// src/pages/datenschutz.astro
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import SiteSchema from "../components/SiteSchema.astro";
import "../styles/global.css";
import "@fontsource/inter/300.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";

const PH_KEY = import.meta.env.PUBLIC_POSTHOG_KEY;
const PH_HOST = import.meta.env.PUBLIC_POSTHOG_HOST;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Datenschutzerklärung | Gewinnarchitekt</title>
    <meta name="description" content="Datenschutzerklärung von Gewinnarchitekt. Informationen darüber, wie wir Ihre personenbezogenen Daten erheben, verarbeiten und schützen." />
    <link rel="canonical" href={canonicalURL} />
    <SiteSchema />

    {PH_KEY && (
      <script is:inline define:vars={{ PH_KEY, PH_HOST }}>
        !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug getPageViewId captureTraceFeedback captureTraceMetric".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
        posthog.init(PH_KEY, { api_host: PH_HOST, defaults: '2025-05-24' });
      </script>
    )}
  </head>
  <body class="bg-white text-slate-900 antialiased">
    <Nav />

    <section class="bg-white border-b border-[#e5e7eb]">
      <div class="max-w-[1280px] mx-auto px-6 lg:px-10 py-20 lg:py-28">
        <div class="grid grid-cols-12 gap-6 lg:gap-10">
          <div class="col-span-12 lg:col-span-3">
            <span class="label-eyebrow">Rechtliches</span>
          </div>
          <div class="col-span-12 lg:col-span-9 max-w-[720px]">
            <h1 class="font-serif-display text-[#1f2937] font-light leading-[1.05] text-[36px] sm:text-[48px] lg:text-[60px] mb-4">
              Datenschutzerklärung
            </h1>
            <p class="text-[14px] text-[#6b7280] italic mb-8">Stand: 2. Juli 2026</p>

            <p class="text-[15px] lg:text-[16px] leading-[1.65] text-[#1f2937] mb-6">
              Gewinnarchitekt Aschwanden<br />
              Karl Aschwanden
            </p>

            <h2 class="font-serif-display text-[#1f2937] text-[22px] lg:text-[26px] leading-[1.2] mt-10 mb-4 border-b border-[#e5e7eb] pb-2">
              1. Verantwortliche Stelle
            </h2>
            <p class="text-[15px] lg:text-[16px] leading-[1.65] text-[#1f2937] mb-2">
              Verantwortlich für die Datenverarbeitung:
            </p>
            <p class="text-[15px] lg:text-[16px] leading-[1.65] text-[#1f2937] mb-2">
              Gewinnarchitekt Aschwanden<br />
              Karl Aschwanden<br />
              Goldbrunnenstrasse 145<br />
              8055 Zürich<br />
              Schweiz
            </p>
            <p class="text-[15px] lg:text-[16px] leading-[1.65] text-[#1f2937] mb-4">
              Rechtsform: Einzelunternehmen<br />
              UID: CHE-233.099.319
            </p>
            <p class="text-[15px] lg:text-[16px] leading-[1.65] text-[#1f2937] mb-4">
              Kontakt:<br />
              E-Mail: <a href="mailto:info@gewinnarchitekt.ch" class="text-[#16a34a] hover:text-[#15803d] underline transition-colors">info@gewinnarchitekt.ch</a><br />
              Telefon: 076 535 26 04
            </p>

            <h2 class="font-serif-display text-[#1f2937] text-[22px] lg:text-[26px] leading-[1.2] mt-10 mb-4 border-b border-[#e5e7eb] pb-2">
              2. Allgemeine Hinweise
            </h2>
            <p class="text-[15px] lg:text-[16px] leading-[1.65] text-[#1f2937] mb-4">
              Gestützt auf Artikel 13 der schweizerischen Bundesverfassung und die datenschutzrechtlichen Bestimmungen des Bundes (Datenschutzgesetz, DSG) hat jede Person Anspruch auf Schutz ihrer Privatsphäre sowie auf Schutz vor Missbrauch ihrer persönlichen Daten.
            </p>
            <p class="text-[15px] lg:text-[16px] leading-[1.65] text-[#1f2937] mb-4">
              Wir nehmen den Schutz Ihrer persönlichen Daten sehr ernst und behandeln Ihre personenbezogenen Daten vertraulich und entsprechend den gesetzlichen Datenschutzvorschriften sowie dieser Datenschutzerklärung.
            </p>

            <h2 class="font-serif-display text-[#1f2937] text-[22px] lg:text-[26px] leading-[1.2] mt-10 mb-4 border-b border-[#e5e7eb] pb-2">
              3. Erfassung und Verarbeitung personenbezogener Daten
            </h2>
            <h3 class="font-serif-display text-[#1f2937] text-[18px] lg:text-[20px] leading-[1.3] mt-6 mb-2">
              3.1 Arten der erfassten Daten
            </h3>
            <p class="text-[15px] lg:text-[16px] leading-[1.65] text-[#1f2937] mb-2">
              Wir können folgende personenbezogene Daten erfassen:
            </p>
            <ul class="list-disc pl-6 mb-4 space-y-1 text-[15px] lg:text-[16px] text-[#1f2937]">
              <li>Kontaktdaten: Name, E-Mail-Adresse, Telefonnummer, Adresse</li>
              <li>Kommunikationsdaten: Inhalt Ihrer Anfragen, Nachrichten und Korrespondenz</li>
              <li>Nutzungsdaten: IP-Adresse, Browser-Informationen, besuchte Seiten, Zugriffszeiten</li>
              <li>Geschäftsdaten: Unternehmensinformationen, Projektdetails, Beratungsanfragen</li>
            </ul>

            <h3 class="font-serif-display text-[#1f2937] text-[18px] lg:text-[20px] leading-[1.3] mt-6 mb-2">
              3.2 Zwecke der Datenverarbeitung
            </h3>
            <p class="text-[15px] lg:text-[16px] leading-[1.65] text-[#1f2937] mb-2">
              Wir verarbeiten Ihre personenbezogenen Daten für folgende Zwecke:
            </p>
            <ul class="list-disc pl-6 mb-4 space-y-1 text-[15px] lg:text-[16px] text-[#1f2937]">
              <li>Erbringung unserer Dienstleistungen</li>
              <li>Bearbeitung von Anfragen und Kundenbetreuung</li>
              <li>Kommunikation und Korrespondenz</li>
              <li>Vertragserfüllung und Rechnungsstellung</li>
              <li>Verbesserung unserer Dienstleistungen</li>
              <li>Einhaltung gesetzlicher Verpflichtungen</li>
            </ul>

            <h3 class="font-serif-display text-[#1f2937] text-[18px] lg:text-[20px] leading-[1.3] mt-6 mb-2">
              3.3 Rechtsgrundlagen
            </h3>
            <p class="text-[15px] lg:text-[16px] leading-[1.65] text-[#1f2937] mb-2">
              Wir verarbeiten Ihre Daten auf folgenden Rechtsgrundlagen:
            </p>
            <ul class="list-disc pl-6 mb-4 space-y-1 text-[15px] lg:text-[16px] text-[#1f2937]">
              <li>Vertragserfüllung: Zur Erfüllung von Verträgen oder vorvertraglichen Massnahmen</li>
              <li>Berechtigte Interessen: Zur Wahrung unserer berechtigten Geschäftsinteressen</li>
              <li>Einwilligung: Bei ausdrücklicher Zustimmung Ihrerseits</li>
              <li>Gesetzliche Verpflichtung: Zur Erfüllung rechtlicher Anforderungen</li>
            </ul>

            <h2 class="font-serif-display text-[#1f2937] text-[22px] lg:text-[26px] leading-[1.2] mt-10 mb-4 border-b border-[#e5e7eb] pb-2">
              4. Hosting und Server-Logfiles
            </h2>
            <p class="text-[15px] lg:text-[16px] leading-[1.65] text-[#1f2937] mb-4">
              Diese Website wird bei Vercel gehostet (Vercel Inc., 340 S Lemon Ave #4133, Walnut, CA 91789, USA). Der Hosting-Provider erhebt und speichert automatisch technische Zugriffsinformationen in sogenannten Server-Logfiles, die Ihr Browser automatisch an uns übermittelt. Hierzu gehören die IP-Adresse, das Datum und die Uhrzeit der Anfrage, der Browsertyp und die Version des Browsers, das verwendete Betriebssystem, die Referrer-URL (die zuvor besuchte Seite) sowie die aufgerufenen Seiten unserer Website.
            </p>
            <p class="text-[15px] lg:text-[16px] leading-[1.65] text-[#1f2937] mb-4">
              Die Erfassung und Verarbeitung dieser Daten ist technisch erforderlich, um die Website korrekt auszuliefern, deren Stabilität und Sicherheit zu gewährleisten sowie die Systemsicherheit zu analysieren. Diese Daten werden nicht mit anderen Datenquellen zusammengeführt. Da sich Vercel in den USA befindet und somit ausserhalb der Schweiz bzw. der Europäischen Union liegt, verweisen wir zusätzlich auf Abschnitt 6 (internationale Datenübertragungen).
            </p>

            <h2 class="font-serif-display text-[#1f2937] text-[22px] lg:text-[26px] leading-[1.2] mt-10 mb-4 border-b border-[#e5e7eb] pb-2">
              5. Datenweitergabe und Empfänger
            </h2>
            <h3 class="font-serif-display text-[#1f2937] text-[18px] lg:text-[20px] leading-[1.3] mt-6 mb-2">
              5.1 Grundsatz
            </h3>
            <p class="text-[15px] lg:text-[16px] leading-[1.65] text-[#1f2937] mb-2">
              Wir geben Ihre personenbezogenen Daten nicht ohne Ihre Einwilligung an Dritte weiter, ausser in folgenden Fällen:
            </p>
            <ul class="list-disc pl-6 mb-4 space-y-1 text-[15px] lg:text-[16px] text-[#1f2937]">
              <li>Zur Erfüllung unserer Dienstleistungen erforderliche Dienstleister</li>
              <li>Gesetzliche Verpflichtungen oder behördliche Anordnungen</li>
              <li>Schutz unserer Rechte und Interessen</li>
            </ul>

            <h3 class="font-serif-display text-[#1f2937] text-[18px] lg:text-[20px] leading-[1.3] mt-6 mb-2">
              5.2 Dienstleister
            </h3>
            <p class="text-[15px] lg:text-[16px] leading-[1.65] text-[#1f2937] mb-4">
              Wir können externe Dienstleister zur Unterstützung unserer Geschäftstätigkeit einsetzen (z.B. IT-Services, Cloud-Anbieter, Buchhaltung). Alle Dienstleister sind vertraglich zur Einhaltung des Datenschutzes verpflichtet.
            </p>
            <p class="text-[15px] lg:text-[16px] leading-[1.65] text-[#1f2937] mb-4">
              Auf dieser Website sind folgende Dienstleister direkt eingebunden bzw. verlinkt:
            </p>
            <ul class="list-disc pl-6 mb-4 space-y-2 text-[15px] lg:text-[16px] text-[#1f2937]">
              <li>
                <strong>PostHog</strong>: Wir nutzen PostHog (PostHog Inc., USA) zur statistischen Auswertung der Websitenutzung, zur Event-Verfolgung und zur Analyse des Nutzerverhaltens (Session Recordings). Die Datenübertragung ist so konfiguriert, dass sie über Server innerhalb der EU (eu.i.posthog.com) abgewickelt wird. PostHog erfasst Informationen wie Ihre IP-Adresse, Client-Details und Ihr Klickverhalten auf der Seite.
              </li>
              <li>
                <strong>TidyCal</strong>: Wir verlinken für die Online-Terminvereinbarung auf das Tool TidyCal (AppSumo, USA). Sobald Sie auf den Link zur Terminbuchung klicken, werden Sie auf die Server von TidyCal weitergeleitet, wo Ihre Angaben für die Buchung erfasst und verarbeitet werden.
              </li>
            </ul>

            <h2 class="font-serif-display text-[#1f2937] text-[22px] lg:text-[26px] leading-[1.2] mt-10 mb-4 border-b border-[#e5e7eb] pb-2">
              6. Internationale Datenübertragungen
            </h2>
            <p class="text-[15px] lg:text-[16px] leading-[1.65] text-[#1f2937] mb-4">
              Bei der Nutzung von Dienstleistern ausserhalb der Schweiz/EU stellen wir durch geeignete Massnahmen (Standardvertragsklauseln, Angemessenheitsbeschlüsse) sicher, dass ein angemessenes Datenschutzniveau gewährleistet ist.
            </p>

            <h2 class="font-serif-display text-[#1f2937] text-[22px] lg:text-[26px] leading-[1.2] mt-10 mb-4 border-b border-[#e5e7eb] pb-2">
              7. Speicherdauer
            </h2>
            <p class="text-[15px] lg:text-[16px] leading-[1.65] text-[#1f2937] mb-4">
              Wir speichern Ihre personenbezogenen Daten nur so lange, wie es für die jeweiligen Zwecke erforderlich ist oder gesetzliche Aufbewahrungsfristen bestehen. Geschäftsunterlagen werden gemäss schweizerischem Obligationenrecht 10 Jahre aufbewahrt. Anfragen ohne Geschäftsbeziehung löschen wir nach angemessener Zeit. Nach Ablauf der Aufbewahrungsfristen werden die Daten sicher gelöscht oder anonymisiert.
            </p>

            <h2 class="font-serif-display text-[#1f2937] text-[22px] lg:text-[26px] leading-[1.2] mt-10 mb-4 border-b border-[#e5e7eb] pb-2">
              8. Cookies und Tracking-Technologien
            </h2>
            <p class="text-[15px] lg:text-[16px] leading-[1.65] text-[#1f2937] mb-4">
              Diese Website verwendet Cookies, um die Nutzererfahrung zu verbessern. Cookies sind kleine Textdateien, die auf Ihrem Gerät gespeichert werden.
              Je nach Konfiguration können folgende Cookie-Arten verwendet werden:
              Notwendige Cookies (erforderlich für grundlegende Website-Funktionen),
              Analyse-Cookies (zur Verbesserung unserer Website, nur mit Ihrer Einwilligung),
              Marketing-Cookies (für personalisierte Inhalte, nur mit Ihrer Einwilligung). Sie können Cookies in Ihren Browser-Einstellungen verwalten, deaktivieren oder löschen.
            </p>
            <p class="text-[15px] lg:text-[16px] leading-[1.65] text-[#1f2937] mb-4">
              Im Detail werden durch die Einbindung von PostHog lokale Speichertechnologien (Local Storage) bzw. Cookies eingesetzt, um Interaktionsdaten auf unserer Website auszuwerten.
            </p>

            <h2 class="font-serif-display text-[#1f2937] text-[22px] lg:text-[26px] leading-[1.2] mt-10 mb-4 border-b border-[#e5e7eb] pb-2">
              9. Ihre Rechte
            </h2>
            <p class="text-[15px] lg:text-[16px] leading-[1.65] text-[#1f2937] mb-2">
              Sie haben folgende Rechte bezüglich Ihrer personenbezogenen Daten:
            </p>
            <ul class="list-disc pl-6 mb-4 space-y-1 text-[15px] lg:text-[16px] text-[#1f2937]">
              <li>Auskunftsrecht: Information über die Verarbeitung Ihrer Daten</li>
              <li>Berichtigungsrecht: Korrektur unrichtiger oder unvollständiger Daten</li>
              <li>Löschungsrecht: Löschung Ihrer Daten unter bestimmten Umständen</li>
              <li>Einschränkungsrecht: Einschränkung der Verarbeitung</li>
              <li>Widerspruchsrecht: Widerspruch gegen die Verarbeitung</li>
              <li>Recht auf Datenherausgabe und -übertragung: Erhalt Ihrer Daten in einem strukturierten Format</li>
              <li>Widerruf der Einwilligung: Jederzeit möglich</li>
            </ul>
            <p class="text-[15px] lg:text-[16px] leading-[1.65] text-[#1f2937] mb-4">
              Zur Ausübung Ihrer Rechte kontaktieren Sie uns unter den oben genannten Kontaktdaten.
            </p>

            <h2 class="font-serif-display text-[#1f2937] text-[22px] lg:text-[26px] leading-[1.2] mt-10 mb-4 border-b border-[#e5e7eb] pb-2">
              10. Kontaktaufnahme
            </h2>
            <p class="text-[15px] lg:text-[16px] leading-[1.65] text-[#1f2937] mb-4">
              Wenn Sie uns über das Kontaktformular oder per E-Mail kontaktieren, werden Ihre Angaben zur Bearbeitung Ihrer Anfrage gespeichert. Diese Daten geben wir nicht ohne Ihre Einwilligung weiter und löschen sie nach abgeschlossener Bearbeitung oder nach gesetzlichen Aufbewahrungsfristen.
            </p>

            <h2 class="font-serif-display text-[#1f2937] text-[22px] lg:text-[26px] leading-[1.2] mt-10 mb-4 border-b border-[#e5e7eb] pb-2">
              11. Datensicherheit
            </h2>
            <p class="text-[15px] lg:text-[16px] leading-[1.65] text-[#1f2937] mb-4">
              Wir treffen angemessene technische und organisatorische Massnahmen zum Schutz Ihrer Daten:
            </p>
            <ul class="list-disc pl-6 mb-4 space-y-1 text-[15px] lg:text-[16px] text-[#1f2937]">
              <li>Verschlüsselung der Datenübertragung und -speicherung</li>
              <li>Zugangskontrollen und Berechtigungsmanagement</li>
              <li>Regelmässige Sicherheitsüberprüfungen</li>
            </ul>
            <p class="text-[15px] lg:text-[16px] leading-[1.65] text-[#1f2937] mb-4">
              Dennoch kann keine absolute Sicherheit garantiert werden. Wir empfehlen Ihnen, keine besonders sensiblen Informationen unverschlüsselt zu übertragen.
            </p>

            <h2 class="font-serif-display text-[#1f2937] text-[22px] lg:text-[26px] leading-[1.2] mt-10 mb-4 border-b border-[#e5e7eb] pb-2">
              12. Änderungen der Datenschutzerklärung
            </h2>
            <p class="text-[15px] lg:text-[16px] leading-[1.65] text-[#1f2937] mb-4">
              Wir können diese Datenschutzerklärung jederzeit anpassen. Die aktuelle Version ist stets auf unserer Website verfügbar. Bei wesentlichen Änderungen werden wir Sie entsprechend informieren.
            </p>

            <h2 class="font-serif-display text-[#1f2937] text-[22px] lg:text-[26px] leading-[1.2] mt-10 mb-4 border-b border-[#e5e7eb] pb-2">
              13. Beschwerderecht
            </h2>
            <p class="text-[15px] lg:text-[16px] leading-[1.65] text-[#1f2937] mb-4">
              Sie haben das Recht, sich an die zuständige Datenschutzbehörde zu wenden:
            </p>
            <p class="text-[15px] lg:text-[16px] leading-[1.65] text-[#1f2937] mb-4">
              Eidgenössischer Datenschutz- und Öffentlichkeitsbeauftragter (EDÖB)<br />
              Feldeggweg 1<br />
              3003 Bern<br />
              Schweiz<br />
              E-Mail: <a href="mailto:info@edoeb.admin.ch" class="text-[#16a34a] hover:text-[#15803d] underline transition-colors">info@edoeb.admin.ch</a>
            </p>

            <h2 class="font-serif-display text-[#1f2937] text-[22px] lg:text-[26px] leading-[1.2] mt-10 mb-4 border-b border-[#e5e7eb] pb-2">
              14. Kontakt bei Datenschutzfragen
            </h2>
            <p class="text-[15px] lg:text-[16px] leading-[1.65] text-[#1f2937] mb-4">
              Bei Fragen zum Datenschutz oder zur Ausübung Ihrer Rechte wenden Sie sich bitte an:
            </p>
            <p class="text-[15px] lg:text-[16px] leading-[1.65] text-[#1f2937] mb-4">
              Gewinnarchitekt Aschwanden<br />
              Karl Aschwanden<br />
              E-Mail: <a href="mailto:info@gewinnarchitekt.ch" class="text-[#16a34a] hover:text-[#15803d] underline transition-colors">info@gewinnarchitekt.ch</a><br />
              Telefon: 076 535 26 04
            </p>
          </div>
        </div>
      </div>
    </section>

    <Footer />
  </body>
</html>
