---
// src/components/Angebot.astro
// Angebots-Karten (Gewinnmodul, Gewinnoptimierung, Gewinnsteuerung).
// Enthält Eyebrow, Headline, Subline, Karten-Grid, Kleingedrucktes und CTA.
---

<section id="Angebot" class="bg-[#f9fafb] border-b border-[#e5e7eb]">
  <div class="max-w-[1280px] mx-auto px-6 lg:px-10 py-16 lg:py-20">
    <!-- Eyebrow + Headline + Subline -->
    <div class="grid grid-cols-12 gap-6 lg:gap-10 mb-10">
      <div class="col-span-12 lg:col-span-2">
        <span class="label-eyebrow">Angebot</span>
      </div>
      <div class="col-span-12 lg:col-span-10">
        <h2
          class="font-serif-display text-[#1f2937] font-light leading-[1.05] text-[36px] sm:text-[48px] lg:text-[60px]"
        >
          Auf Ihre Bedürfnisse ausgerichtet.
        </h2>
        <p class="mt-4 max-w-[700px] text-[15px] leading-[1.6] text-[#6b7280]">
          Ob einmaliges Projekt oder laufende Begleitung, Sie wählen die für Sie passende Art der Zusammenarbeit.
        </p>
      </div>
    </div>

    <!-- Card grid: 1 full-width + 2 half-width -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">

      <!-- Karte 1 -->
      <article class="angebot-card angebot-card--featured lg:col-span-2 bg-[#f3f6f4] border border-[#e5e7eb] border-t-4 border-t-[#16a34a] p-8 lg:p-10 flex flex-col">
        <h3 class="angebot-card__title font-serif-display text-[#1f2937] text-[22px] lg:text-[24px] leading-tight mb-3">
          Gewinnmodul
        </h3>
        <p class="angebot-card__promise text-[14px] font-medium text-[#16a34a] mb-5">
          Klare, auf Ihre Bedürfnisse ausgerichtete, Ergebnisse
        </p>
        <div class="mb-5">
          <p class="angebot-card__price text-[20px] lg:text-[22px] font-semibold text-[#1f2937] leading-snug">
            CHF 4'900 pro Modul
          </p>
          <p class="angebot-card__secondary text-[13px] lg:text-[14px] leading-[1.5] text-[#6b7280] mt-1">
            Alle sechs Module: CHF 24'500
          </p>
        </div>
        <p class="angebot-card__fit text-[13px] leading-[1.55] text-[#6b7280] mt-auto pt-4 border-t border-[#e5e7eb]">
          Die Module des P·R·O·F·I·T Frameworks, einzeln oder als Gesamtpaket.
        </p>
      </article>

      <!-- Karte 2 -->
      <article class="angebot-card bg-white border border-[#e5e7eb] p-8 lg:p-10 flex flex-col">
        <h3 class="angebot-card__title font-serif-display text-[#1f2937] text-[22px] lg:text-[24px] leading-tight mb-3">
          Gewinnoptimierung
        </h3>
        <p class="angebot-card__promise text-[14px] font-medium text-[#16a34a] mb-5">
          Kontinuierliche Kontrolle auch nach Projektabschluss.
        </p>
        <div class="mb-5">
          <p class="angebot-card__price text-[20px] lg:text-[22px] font-semibold text-[#1f2937] leading-snug lg:whitespace-nowrap">
            1&nbsp;% des Monatsumsatzes
          </p>
          <p class="angebot-card__secondary text-[13px] lg:text-[14px] leading-[1.5] text-[#6b7280] mt-2.5 lg:whitespace-nowrap">
            Maximal CHF&nbsp;3'700 pro Monat
          </p>
          <p class="angebot-card__secondary text-[13px] lg:text-[14px] leading-[1.5] text-[#6b7280] mt-1.5">
            Einmaliges Setup: CHF&nbsp;2'900
          </p>
        </div>
        <p class="angebot-card__fit text-[13px] leading-[1.55] text-[#6b7280] mt-auto pt-4 border-t border-[#e5e7eb]">
          Monatliche Abstimmung · laufende Aktualisierung von Modellen und Dashboards · Erfolgskontrolle laufender Massnahmen
        </p>
      </article>

      <!-- Karte 3 -->
      <article class="angebot-card bg-white border border-[#e5e7eb] p-8 lg:p-10 flex flex-col">
        <h3 class="angebot-card__title font-serif-display text-[#1f2937] text-[22px] lg:text-[24px] leading-tight mb-3">
          Gewinnsteuerung
        </h3>
        <p class="angebot-card__promise text-[14px] font-medium text-[#16a34a] mb-5">
          Proaktive Planung auch nach Projektabschluss.
        </p>
        <div class="mb-5">
          <p class="angebot-card__price text-[20px] lg:text-[22px] font-semibold text-[#1f2937] leading-snug lg:whitespace-nowrap">
            2&nbsp;% des Monatsumsatzes
          </p>
          <p class="angebot-card__secondary text-[13px] lg:text-[14px] leading-[1.5] text-[#6b7280] mt-2.5 lg:whitespace-nowrap">
            Maximal CHF&nbsp;7'400 pro Monat
          </p>
          <p class="angebot-card__secondary text-[13px] lg:text-[14px] leading-[1.5] text-[#6b7280] mt-1.5">
            Einmaliges Setup: CHF&nbsp;4'900
          </p>
        </div>
        <p class="angebot-card__fit text-[13px] leading-[1.55] text-[#6b7280] mt-auto pt-4 border-t border-[#e5e7eb]">
          Wöchentliche Abstimmung · Umsetzung zentraler Pricing-Projekte · alle Leistungen der Gewinnoptimierung
        </p>
      </article>
    </div>

    <p class="mt-5 text-[13px] leading-[1.5] text-[#6b7280]">
      Berechnungsbasis: Umsatz des abgelaufenen Monats. Monatlich kündbar.
    </p>

    <div class="mt-8">
      <a
        href="https://tidycal.com/gewinnarchitekt/kennenlernen"
        target="_blank"
        rel="noopener"
        data-ph-event="cta_clicked"
        data-ph-location="angebot_cards"
        class="inline-flex items-center gap-2 bg-[#16a34a] text-white text-[14px] font-medium px-6 py-4 hover:bg-[#15803d] transition-colors w-full sm:w-auto justify-center"
      >
        Erstgespräch buchen: 20 Minuten, kostenlos
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
      </a>
    </div>
  </div>
</section>
