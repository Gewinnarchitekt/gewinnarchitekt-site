---
// src/components/Hero.astro
import goldbachLogo from '../assets/logos/goldbach.svg';
import txgroupLogo from '../assets/logos/txgroup.svg';
import swisscardLogo from '../assets/logos/swisscard.svg';
import sunriseLogo from '../assets/logos/sunrise.svg';
---

<!-- Dark hero with architectural background + upward-panning facade -->
<section id="top" class="relative bg-[#1f2937] text-white overflow-hidden">
  <!-- Full-bleed architectural background image with upward scroll animation -->
  <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
    <div
      class="hero-bg-img absolute inset-x-0 grayscale"
      style="top: 0; height: 140%; background-image: url('https://images.unsplash.com/photo-1494522855154-9297ac14b55f?auto=format&fit=crop&w=2000&q=85'); background-size: cover; background-position: center;"
    ></div>

    <!-- Layered overlays for legibility -->
    <div class="absolute inset-0 bg-[#1f2937]/80"></div>
    <div
      class="absolute inset-0 bg-gradient-to-r from-[#1f2937]/75 via-[#1f2937]/50 to-[#1f2937]/30"
    >
    </div>
  </div>

  <div
    class="relative max-w-[1280px] mx-auto px-6 lg:px-10 pt-24 lg:pt-36 pb-28 lg:pb-40"
  >
    <!-- Eyebrow row -->
    <div class="flex items-center mb-14 lg:mb-20">
      <div class="flex items-center gap-2.5">
        <span class="inline-block w-1.5 h-1.5 bg-[#16a34a]"></span>
        <span class="text-[13px] font-medium text-white">
          Pricing &amp; Profitarchitektur
          <span class="text-white/65 font-normal"> · Zürich</span>
        </span>
      </div>
    </div>

    <!-- Headline -->
    <h1
      class="font-display font-light text-white leading-[1.1] text-[32px] sm:text-[42px] lg:text-[54px] max-w-[920px]"
    >
      <span class="text-[#16a34a]">Gewinn</span> ist eine Frage der Methodik, nicht
      des Zufalls.
    </h1>

    <!-- Sub-copy + CTA row -->
    <div
      class="grid grid-cols-12 gap-6 lg:gap-10 mt-16 lg:mt-24 pt-10 border-t border-white/20"
    >
      <div class="col-span-12 lg:col-span-6">
        <div class="flex items-center gap-2.5 mb-4">
          <span class="inline-block w-1.5 h-1.5 bg-[#16a34a]"></span>
          <span
            class="text-[11px] tracking-[0.18em] uppercase font-semibold text-white"
          >
            Ansatz
          </span>
        </div>
        <p
          class="text-[16px] lg:text-[18px] leading-[1.6] text-white/90 max-w-[560px]"
        >
          Wenn Produktstrategie und Finanzdaten perfekt synchronisiert sind,
          wird Profit planbar. Ich ersetze Meinungen durch
          fundierte Entscheidungsgrundlagen und schaffe so die Basis für nachhaltiges
          Wachstum und messbar höhere Gewinne.
        </p>
      </div>

      <div
        class="col-span-12 lg:col-span-5 lg:col-start-8 flex flex-col justify-end"
      >
        <div class="flex flex-wrap gap-3">
          <a
            href="https://tidycal.com/gewinnarchitekt/kennenlernen"
            target="_blank"
            rel="noopener"
            data-ph-event="cta_clicked"
            data-ph-location="hero"
            class="inline-flex items-center gap-3 bg-[#16a34a] text-white text-[14px] font-medium px-6 py-4 hover:bg-[#15803d] transition-colors"
          >
            Termin vereinbaren
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.25"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-4 h-4"
              ><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg
            >
          </a>
        </div>
        <p class="mt-4 text-[12px] text-white/65">
          Unverbindlich · Persönlich · Direkt
        </p>
      </div>
    </div>
  </div>

  <!-- Berufliche Stationen Logo Band -->
  <div 
    class="relative bg-white/10 backdrop-blur-sm border-t border-white/15 py-6 md:py-8" 
    aria-label="Berufliche Stationen"
  >
    <div class="max-w-[1280px] mx-auto px-6 lg:px-10">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 lg:gap-12">
        <span class="text-[11px] tracking-[0.18em] uppercase font-semibold text-white/50 whitespace-nowrap">
          20 JAHRE ERFAHRUNG BEI
        </span>
        <div class="flex flex-wrap items-center justify-around lg:justify-between gap-y-5 gap-x-6 sm:gap-x-10 lg:gap-x-12 w-full max-w-[480px] lg:max-w-none mx-auto lg:mx-0 lg:w-auto lg:flex-nowrap">
          <img 
            src={goldbachLogo.src} 
            alt="Goldbach" 
            class="h-[16px] sm:h-[20px] md:h-[24px] w-auto object-contain opacity-55 brightness-0 invert" 
          />
          <img 
            src={txgroupLogo.src} 
            alt="TX Group" 
            class="h-[22px] sm:h-[26px] md:h-[30px] w-auto object-contain opacity-55 brightness-0 invert" 
          />
          <img 
            src={swisscardLogo.src} 
            alt="Swisscard" 
            class="h-[18px] sm:h-[22px] md:h-[26px] w-auto object-contain opacity-55 brightness-0 invert" 
          />
          <img 
            src={sunriseLogo.src} 
            alt="Sunrise" 
            class="h-[24px] sm:h-[28px] md:h-[32px] w-auto object-contain opacity-55 brightness-0 invert" 
          />
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Upward-panning facade animation — GPU-accelerated -->
<style is:global>
  @keyframes panUp {
    0% {
      transform: translateY(0);
    }
    100% {
      transform: translateY(-28.5%);
    }
  }

  .hero-bg-img {
    will-change: transform;
    animation: panUp 25s linear infinite alternate;
  }
</style>
