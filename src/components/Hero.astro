---
// src/components/Hero.astro
const stats = [
  { k: '20+', v: 'Jahre Erfahrung' },
  { k: 'MBA', v: 'IE Business School' },
  { k: 'CFM', v: 'Chartered Financial Modeler' },
  { k: 'Zürich', v: 'Sitz · Schweiz' }
];
---

<!-- Dark hero with architectural background -->
<section id="top" class="relative bg-[#1f2937] text-white overflow-hidden">
  
  <!-- Full-bleed architectural background image -->
  <div class="absolute inset-0" aria-hidden="true">
    <img
      src="https://images.unsplash.com/photo-1518005020951-eccb494ad742?auto=format&fit=crop&w=2000&q=65"
      alt=""
      class="w-full h-full object-cover grayscale" />
    
    <!-- Layered overlays for legibility -->
    <div class="absolute inset-0 bg-[#1f2937]/85"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#1f2937]/80 via-[#1f2937]/55 to-[#1f2937]/35"></div>
  </div>

  <div class="relative max-w-[1280px] mx-auto px-6 lg:px-10 pt-16 lg:pt-24 pb-20 lg:pb-28">
    <!-- Eyebrow row -->
    <div class="flex items-center mb-12 lg:mb-16">
      <div class="flex items-center gap-2.5">
        <span class="inline-block w-1.5 h-1.5 bg-[#16a34a]"></span>
        <span class="text-[13px] font-medium text-white">
          Pricing &amp; Profitarchitektur
          <span class="text-white/65 font-normal"> · Zürich</span>
        </span>
      </div>
    </div>

    <!-- Headline -->
    <h1 class="font-display font-light text-white leading-[1.1] text-[32px] sm:text-[42px] lg:text-[54px] max-w-[920px]">
      <span class="text-[#16a34a]">Gewinn</span> ist eine Frage der
      Methodik, nicht des Zufalls.
    </h1>

    <!-- Sub-copy + CTA row -->
    <div class="grid grid-cols-12 gap-6 lg:gap-10 mt-14 lg:mt-20 pt-10 border-t border-white/20">
      <div class="col-span-12 lg:col-span-6">
        <div class="flex items-center gap-2.5 mb-4">
          <span class="inline-block w-1.5 h-1.5 bg-[#16a34a]"></span>
          <span class="text-[11px] tracking-[0.18em] uppercase font-semibold text-white">
            Ansatz
          </span>
        </div>
        <p class="text-[16px] lg:text-[18px] leading-[1.6] text-white/90 max-w-[560px]">
          Wenn Produktstrategie und Finanzdaten perfekt synchronisiert
          sind, entsteht eine überlegene Ertragslogik. Ich ersetze
          Meinungen durch präzise Finanzmodelle und schaffen so die Basis
          für nachhaltiges Wachstum und messbar höheren Profit.
        </p>
      </div>

      <div class="col-span-12 lg:col-span-5 lg:col-start-8 flex flex-col justify-end">
        <div class="flex flex-wrap gap-3">
          <a
            href="https://tidycal.com/gewinnarchitekt/potenzialcheck"
            target="_blank"
            rel="noopener"
            data-ph-event="cta_clicked"
            data-ph-location="hero"
            class="inline-flex items-center gap-3 bg-[#16a34a] text-white text-[14px] font-medium px-6 py-4 hover:bg-[#15803d] transition-colors">
            20-Minuten-Potenzial-Check
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
          </a>

        </div>
        <p class="mt-4 text-[12px] text-white/65">
          Unverbindlich · Persönlich · Direkt
        </p>
      </div>
    </div>
  </div>
</section>

<!-- Stat strip — clean white band, separates the dark hero from the next section -->
<section
  aria-label="Kennzahlen"
  class="bg-white border-b border-[#e5e7eb]">
  <div class="max-w-[1280px] mx-auto px-6 lg:px-10">
    <div class="grid grid-cols-2 lg:grid-cols-4">
      {stats.map((s, i) => (
        <div class={`py-8 lg:py-10 px-4 lg:px-6
            ${i > 0 ? 'lg:border-l border-[#e5e7eb]' : ''}
            ${i === 1 ? 'border-l border-[#e5e7eb]' : ''}
            ${i >= 2 ? 'border-t lg:border-t-0' : ''}
            ${i === 3 ? 'border-l border-[#e5e7eb]' : ''}
          `}>
          <div class="font-display font-light text-[#1f2937] text-3xl lg:text-5xl leading-none">
            {s.k}
          </div>
          <div class="text-[11px] tracking-[0.15em] uppercase text-[#6b7280] mt-3">
            {s.v}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
