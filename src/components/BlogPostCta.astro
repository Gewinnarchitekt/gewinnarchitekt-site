---
// src/components/BlogPostCta.astro
---

<div class="border-t border-[#e5e7eb] pt-12 mt-16">
  <div class="bg-[#f9fafb] border border-[#e5e7eb] p-8 sm:p-10">
    <h3 class="font-serif-display text-[22px] sm:text-[26px] font-light leading-[1.2] text-[#1f2937] mb-3">
      Möchten Sie das Profitpotenzial Ihres Unternehmens präzise analysieren?
    </h3>
    <p class="text-[15px] sm:text-[16px] leading-[1.7] text-[#4b5563] mb-6 max-w-[640px]">
      In einem unverbindlichen 30-minütigen Erstgespräch identifizieren wir Ihre Hebel bei Pricing und Deckungsbeitrag.
    </p>
    <a
      href="https://tidycal.com/gewinnarchitekt/kennenlernen"
      target="_blank"
      rel="noopener"
      data-ph-event="cta_clicked"
      data-ph-location="blog_post"
      class="inline-block bg-[#16a34a] text-white font-medium text-[15px] px-6 py-3.5 hover:bg-[#15803d] transition-colors rounded-none"
    >
      Erstgespräch vereinbaren
    </a>
  </div>
</div>
