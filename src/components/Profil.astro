---
// src/components/Profil.astro
import { Image } from 'astro:assets';
import karlPortrait from '../assets/karl.jpeg';

const facts = [
  { k: 'Jahre Erfahrung', v: '20+' },
  { k: 'Spezialisierung', v: 'Financial Services, Telekommunikation, Media, Abomodelle' },
  { k: 'Zertifizierung', v: 'Chartered Financial Modeler' },
  { k: 'Aus- & Weiterbildung', v: ['MBA IE Business School', 'BBA FHNW', 'diverse Kurse in Applied Data Science & AI'] }
];
---

<section id="kontakt" class="bg-white border-b border-[#e5e7eb]">
  <div class="max-w-[1280px] mx-auto px-6 lg:px-10 py-20 lg:py-28">
    <!-- Eyebrow -->
    <div class="grid grid-cols-12 gap-6 lg:gap-10 mb-16">
      <div class="col-span-12 lg:col-span-2">
        <span class="label-eyebrow">Erstgespräch</span>
      </div>
    </div>

    <!-- Main Two-Column Content -->
    <div class="grid grid-cols-12 gap-6 lg:gap-16 items-start">
      <!-- LEFT COLUMN — AUTHORITY (JUST the flip-card) -->
      <div class="col-span-12 lg:col-span-6 flex justify-center lg:justify-start">
        <div 
          class="flip-card aspect-[4/5] w-full max-w-[480px] cursor-pointer relative" 
          id="flip-card"
          role="button"
          tabindex="0"
          aria-label="Karl Aschwanden Visitenkarte. Klicken oder Leertaste drücken zum Umdrehen für Details und Ausbildung."
          aria-expanded="false"
        >
          <div class="flip-card-inner border border-[#e5e7eb] rounded-[6px] shadow-sm bg-white">
            <!-- FRONT FACE -->
            <div class="flip-card-front overflow-hidden rounded-[6px]">
              <Image
                src={karlPortrait}
                alt="Karl Aschwanden, Founder · Zürich"
                widths={[400, 600, 800, 1200]}
                sizes="(max-width: 1024px) 90vw, 40vw"
                class="absolute inset-0 w-full h-full object-cover"
              />
              <!-- Overlaid Name Plate -->
              <div class="absolute bottom-4 inset-x-4 bg-[#1f2937] text-white p-4 rounded-[4px] flex items-center justify-between shadow-md">
                <div class="space-y-0.5 pr-2">
                  <div class="font-display font-medium text-[16px] sm:text-[18px] leading-tight">Karl Aschwanden</div>
                  <div class="text-[10px] sm:text-[11px] text-white/75 font-sans tracking-wide">
                    Produktstrategie, Pricing & Finanzmodellierung
                  </div>
                </div>
                <!-- Affordance Icon -->
                <div class="text-white/60 hover:text-white transition-colors p-1 shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
                </div>
              </div>
            </div>

            <!-- BACK FACE -->
            <div class="flip-card-back p-5 sm:p-6 lg:p-8 flex flex-col justify-between overflow-hidden rounded-[6px] bg-white">
              <div>
                <!-- Header -->
                <div class="flex items-baseline justify-between border-b border-[#e5e7eb] pb-3 mb-4">
                  <h3 class="font-display text-[#1f2937] text-[18px] sm:text-[22px] font-semibold">
                    Karl Aschwanden
                  </h3>
                  <span class="text-[10px] tracking-[0.2em] uppercase text-[#6b7280]">
                    Gründer
                  </span>
                </div>

                <!-- Bio paragraph -->
                <p class="text-[12px] sm:text-[13px] lg:text-[14px] leading-relaxed text-[#6b7280] mb-4">
                  Viele Unternehmen entwickeln exzellente Produkte, verschenken aber bei der Monetarisierung massiv Marge. Mit Stationen bei Branchenführern wie Sunrise, Swisscard und Goldbach habe ich erfolgreiche Erlösmodelle von Grund auf konzipiert und operativ implementiert.
                </p>

                <!-- Credentials table -->
                <dl class="border-t border-[#1f2937] text-[11px] sm:text-[12px] lg:text-[13px]">
                  {facts.map((f) => (
                    <div class="grid grid-cols-12 py-1.5 sm:py-2 border-b border-[#e5e7eb]">
                      <dt class="col-span-5 text-[#6b7280]">{f.k}</dt>
                      <dd class="col-span-7 text-[#1f2937] font-medium">
                        {Array.isArray(f.v) ? (
                          <span class="flex flex-col gap-0.5">
                            {f.v.map((line) => (
                              <span>{line}</span>
                            ))}
                          </span>
                        ) : (
                          f.v
                        )}
                      </dd>
                    </div>
                  ))}
                </dl>
              </div>

              <!-- Bottom Row: Contact Links + Return Button -->
              <div class="mt-4 pt-2 flex items-center justify-between">
                <!-- Contact Info -->
                <div class="flex items-center gap-4 text-[11px] sm:text-[12px] font-medium">
                  <a 
                    href="mailto:karl@gewinnarchitekt.ch" 
                    class="text-[#16a34a] hover:text-[#15803d] flex items-center gap-1.5 transition-colors"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                    Email
                  </a>
                  <a 
                    href="https://www.linkedin.com/in/karlaschwanden/" 
                    target="_blank" 
                    rel="noopener" 
                    class="text-[#16a34a] hover:text-[#15803d] flex items-center gap-1.5 transition-colors"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
                    LinkedIn
                  </a>
                </div>

                <!-- Return Button -->
                <button 
                  class="text-[#6b7280] hover:text-[#16a34a] text-[11px] font-medium inline-flex items-center gap-1.5 transition-colors" 
                  id="flip-trigger-back"
                  aria-label="Zur Vorderseite zurückdrehen"
                >
                  Zur Vorderseite
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN — ACTION -->
      <div class="col-span-12 lg:col-span-6 lg:col-start-7 space-y-10 mt-12 lg:mt-0">
        <h3 class="font-display text-[#1f2937] text-[36px] sm:text-[42px] lg:text-[48px] leading-[1.1]">
          Der Weg zu einer Zusammenarbeit.
        </h3>

        <!-- Numbered steps -->
        <div class="space-y-8">
          <!-- Step 1 -->
          <div class="border-t border-[#e5e7eb] pt-6">
            <h4 class="font-serif-display text-[#1f2937] text-[20px] lg:text-[22px] font-semibold mb-2">20 Minuten Kennenlernen</h4>
            <p class="text-[15px] leading-[1.65] text-[#6b7280]">
              Wir lernen uns kennen und schauen, ob die Chemie stimmt.
            </p>
          </div>

          <!-- Step 2 -->
          <div class="border-t border-[#e5e7eb] pt-6">
            <h4 class="font-serif-display text-[#1f2937] text-[20px] lg:text-[22px] font-semibold mb-2">60 Minuten Bestandesaufnahme</h4>
            <p class="text-[15px] leading-[1.65] text-[#6b7280]">
              Ich verschaffe mir ein klares Bild Ihrer Preis-, Margen- und Kostenstruktur.
            </p>
          </div>

          <!-- Step 3 -->
          <div class="border-t border-[#e5e7eb] pt-6">
            <h4 class="font-serif-display text-[#1f2937] text-[20px] lg:text-[22px] font-semibold mb-2">Vorschlag prüfen</h4>
            <p class="text-[15px] leading-[1.65] text-[#6b7280]">
              Sie erhalten einen konkreten Vorschlag, zugeschnitten auf Ihre Situation.
            </p>
          </div>

          <!-- Step 4 -->
          <div class="border-t border-[#e5e7eb] pt-6">
            <h4 class="font-serif-display text-[#1f2937] text-[20px] lg:text-[22px] font-semibold mb-2">Start der Zusammenarbeit</h4>
            <p class="text-[15px] leading-[1.65] text-[#6b7280]">
              Wir starten sobald Sie zusagen.
            </p>
          </div>
        </div>

        <!-- Primary CTA + Reassurance -->
        <div class="pt-8 border-t border-[#e5e7eb]">
          <div class="flex flex-col items-start gap-3">
            <a
              href="https://tidycal.com/gewinnarchitekt/potenzialcheck"
              target="_blank"
              rel="noopener"
              data-ph-event="cta_clicked"
              data-ph-location="closing"
              class="inline-flex items-center gap-3 bg-[#16a34a] text-white text-[14px] font-medium px-6 py-4 hover:bg-[#15803d] transition-colors"
            >
              Potenzial-Check starten
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.25"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-4 h-4"
              >
                <path d="M7 7h10v10"></path>
                <path d="M7 17 17 7"></path>
              </svg>
            </a>
            <p class="text-[12px] text-[#6b7280]">
              alles kostenlos und unverbindlich
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .flip-card {
    perspective: 1000px;
  }
  .flip-card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    transform-style: preserve-3d;
  }
  .flip-card.is-flipped .flip-card-inner {
    transform: rotateY(180deg);
  }
  .flip-card-front,
  .flip-card-back {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .flip-card-back {
    transform: rotateY(180deg);
  }
  
  @media (prefers-reduced-motion: reduce) {
    .flip-card-inner {
      transition: none;
    }
  }
</style>

<script>
  const card = document.getElementById('flip-card');

  if (card) {
    const frontFace = card.querySelector('.flip-card-front');
    if (frontFace) {
      frontFace.addEventListener('click', () => {
        card.classList.add('is-flipped');
        card.setAttribute('aria-expanded', 'true');
      });
    }

    const backFace = card.querySelector('.flip-card-back');
    if (backFace) {
      backFace.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        if (target && target.closest('a')) {
          // Allow clicks on actual links (like email and linkedin) to proceed
          return;
        }
        card.classList.remove('is-flipped');
        card.setAttribute('aria-expanded', 'false');
      });
    }

    card.addEventListener('keydown', (e) => {
      if (e.key === ' ' || e.key === 'Enter') {
        e.preventDefault();
        card.classList.toggle('is-flipped');
        const isFlipped = card.classList.contains('is-flipped');
        card.setAttribute('aria-expanded', isFlipped ? 'true' : 'false');
      }
    });
  }
</script>
