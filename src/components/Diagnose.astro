---
// src/components/Diagnose.astro

const row1 = [
  {
    title: 'Mehr Umsatz, kaum mehr Gewinn',
    body: 'Der Umsatz ist deutlich gewachsen, aber Sie merken davon erstaunlich wenig auf Ihrem Konto. Niemand kann Ihnen genau sagen, wo die Marge unterwegs verloren geht.'
  },
  {
    title: 'Unklare Produkteprofitabilität',
    body: 'Sie haben ein breites Sortiment, aber kein klares Bild, welche Produkte den höchsten Gewinnbeitrag leisten. Wo Sie ansetzen müssten, bleibt Vermutung.'
  },
  {
    title: 'Vom Listenpreis bleibt wenig übrig',
    body: 'Sonderkonditionen und Zugeständnisse wirken einzeln klein, kosten Sie in Summe aber ein Vermögen.'
  }
];

const row2 = [
  {
    title: 'Angebote verkaufen sich nicht',
    body: 'Ihr Produkt ist stark, aber die Kunden verstehen den Mehrwert nicht. Sie entscheiden über den Preis und die Marge leidet.'
  },
  {
    title: 'Entscheidungen ohne Datengrundlage',
    body: 'Eine grössere Investition oder Einstellung steht an. Am Ende entscheiden Sie aus dem Bauch, weil eine durchgerechnete Grundlage fehlt.'
  },
  {
    title: 'Das Modell stösst an Grenzen',
    body: 'Das Geschäftsmodell, das Sie hierher gebracht hat, trägt nicht automatisch weiter. Ein neues Preismodell oder ein zusätzliches Segment steht im Raum.'
  }
];

const groups = [
  { label: 'Vergangenheit', cards: row1 },
  { label: 'Zukunft', cards: row2 }
];
---

<section id="Diagnose" class="bg-[#f9fafb] border-b border-[#e5e7eb]">
  <div class="max-w-[1280px] mx-auto px-6 lg:px-10 py-20 lg:py-28">
    <div class="grid grid-cols-12 gap-6 lg:gap-10 mb-16">
      <div class="col-span-12 lg:col-span-2">
        <span class="label-eyebrow">01 Diagnose</span>
      </div>
      <div class="col-span-12 lg:col-span-10">
        <h2 class="font-serif-display text-[#1f2937] font-light leading-[1.05] text-[36px] sm:text-[48px] lg:text-[60px]">
          Gewinne optimieren heisst Schwachstellen <span class="text-[#16a34a]">eliminieren</span>.
        </h2>
        <p class="mt-6 max-w-[700px] text-[16px] leading-[1.6] text-[#6b7280]">
          Ich helfe Firmen, die sich in einer der folgenden Situationen wiederfinden:
        </p>
      </div>
    </div>

    {groups.map((group, i) => (
      <div class={`flex gap-0 ${i > 0 ? 'mt-8' : ''}`}>
        <div class="hidden lg:flex items-center justify-center w-10 shrink-0">
          <span class="text-[10px] tracking-[0.25em] uppercase text-[#9ca3af] whitespace-nowrap" style="writing-mode: vertical-lr; transform: rotate(180deg);">{group.label}</span>
        </div>
        <div class="flex-1 grid grid-cols-1 lg:grid-cols-3 gap-5">
          {group.cards.map((c) => (
            <article class="bg-white border border-[#e5e7eb] rounded-[6px] p-8 lg:p-10 flex flex-col">
              <h3 class="font-serif-display text-[#1f2937] text-[22px] lg:text-[24px] leading-tight mb-4">
                {c.title}
              </h3>
              <p class="text-[15px] leading-[1.65] text-[#6b7280]">
                {c.body}
              </p>
            </article>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>


