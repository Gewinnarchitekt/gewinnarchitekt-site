---
// src/components/Diagnose.astro

const columns = [
  {
    label: "01 · Unsichtbare Gewinnfresser",
    question: "Wo bleibt die Marge?",
    situation: "Der Umsatz wächst oder bleibt stabil, aber am Ende des Monats bleibt spürbar zu wenig Gewinn übrig.",
    ursache: "Unklare Kunden- und Produktprofitabilität, versteckte Rabatte und ineffiziente Kostenstrukturen."
  },
  {
    label: "02 · Unter Wert verkauft",
    question: "Stimmt der Preis?",
    situation: "Preise basieren auf Bauchgefühl oder Konkurrenzvergleichen statt auf echtem Gegenwert und Zahlungsbereitschaft.",
    ursache: "Fehlende Preis- und Angebotsstruktur, unstrukturierte Rabattlogik und Scheu vor Preisanpassungen."
  },
  {
    label: "03 · Entscheiden im Blindflug",
    question: "Rechnet sich das?",
    situation: "Strategische Entscheide zu neuen Produkten, Rabatten oder Wachstumsschritten fallen ohne verlässliches Finanzmodell.",
    ursache: "Fehlendes Reporting, keine Szenarioanalysen und unklare Kennzahlen im Alltag."
  }
];
---

<section id="diagnose" class="bg-[#f9fafb] border-b border-[#e5e7eb]">
  <div class="max-w-[1280px] mx-auto px-6 lg:px-10 py-20 lg:py-28">
    <div class="grid grid-cols-12 gap-6 lg:gap-10 mb-16">
      <div class="col-span-12 lg:col-span-2">
        <span class="label-eyebrow">DIAGNOSE</span>
      </div>
      <div class="col-span-12 lg:col-span-10">
        <h2 class="font-serif-display text-[#1f2937] font-light leading-[1.05] text-[36px] sm:text-[48px] lg:text-[60px]">
          Gewinne optimieren heisst <span class="text-[#16a34a]">Schwachstellen eliminieren</span>.
        </h2>
        <p class="mt-6 max-w-[700px] text-[16px] leading-[1.6] text-[#6b7280]">
          Für Startups und KMU mit digitalen Produkten, die sich oftmals die folgenden Fragen stellen:
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8 lg:gap-y-0">
      {columns.map((c) => (
        <article class="bg-white border border-[#e5e7eb] rounded-[6px] p-8 lg:p-10 flex flex-col lg:grid lg:grid-rows-subgrid lg:row-span-4">
          <span class="label-eyebrow mb-6 block">{c.label}</span>
          <h3 class="font-serif-display text-[#1f2937] text-[22px] lg:text-[24px] leading-snug mb-8">
            {c.question}
          </h3>
          <p class="text-[15px] leading-[1.7] text-[#6b7280] mb-6">
            <span class="font-bold text-[#1f2937]">Die Situation:</span> {c.situation}
          </p>
          <p class="text-[15px] leading-[1.7] text-[#6b7280]">
            <span class="font-bold text-[#1f2937]">Die Ursache:</span> {c.ursache}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
