---
// src/components/Diagnose.astro

const row1 = [
  {
    title: 'Gewinn hält nicht mit dem Umsatz Schritt',
    body: 'Der Umsatz wächst spürbar, das Bankkonto aber nicht. Niemand weiss wo Marge verloren geht.'
  },
  {
    title: 'Unklare Produkteprofitabilität',
    body: 'Das Portfolio rechnet sich als Ganzes, aber es fehlt Transparenz über die Profitabilität einzelner Produkte.'
  },
  {
    title: 'Lücken zwischen Listenpreis und Geschäftserlös',
    body: 'Sonderkonditionen und Zugeständnisse wirken einzeln klein, kosten in Summe aber ein Vermögen.'
  }
];

const row2 = [
  {
    title: 'Angebote verkaufen sich unter den Erwartungen',
    body: 'Das Produkt ist stark, aber die Kunden verstehen den Mehrwert nicht. Der Preis wird als Hindernis wahrgenommen.'
  },
  {
    title: 'Entscheidungen ohne Datengrundlage',
    body: 'Investitions- oder Produktentscheide werden aufgrund von Intuition gefällt. Es fehlen durchgerechnete Szenarien als Entscheidungshilfe.'
  },
  {
    title: 'Geschäftsmodell stösst an Grenzen',
    body: 'Bisherige Erfolgsrezepte funtkionieren nicht mehr und das Geschäft ist zu wenig auf den Markt ausgerichtet.'
  }
];

const groups = [
  { label: 'Vergangenheit', cards: row1 },
  { label: 'Zukunft', cards: row2 }
];
---

<section id="diagnose" class="bg-[#f9fafb] border-b border-[#e5e7eb]">
  <div class="max-w-[1280px] mx-auto px-6 lg:px-10 py-20 lg:py-28">
    <div class="grid grid-cols-12 gap-6 lg:gap-10 mb-16">
      <div class="col-span-12 lg:col-span-2">
        <span class="label-eyebrow">Diagnose</span>
      </div>
      <div class="col-span-12 lg:col-span-10">
        <h2 class="font-serif-display text-[#1f2937] font-light leading-[1.05] text-[36px] sm:text-[48px] lg:text-[60px]">
          Gewinne optimieren heisst <span class="text-[#16a34a]">Schwachstellen eliminieren</span>.
        </h2>
        <p class="mt-6 max-w-[700px] text-[16px] leading-[1.6] text-[#6b7280]">
          Für Startups und KMU mit digitalen Geschäftsmodellen, die sich in einer der folgenden Situationen wiederfinden:
        </p>
      </div>
    </div>

    {groups.map((group, i) => (
      <div class={`${i > 0 ? 'mt-8' : ''} grid grid-cols-1 lg:grid-cols-3 gap-5`}>
        {group.cards.map((c) => (
          <article class="bg-white border border-[#e5e7eb] rounded-[6px] p-8 lg:p-10 flex flex-col">
            <h3 class="font-serif-display text-[#1f2937] text-[22px] lg:text-[24px] leading-tight mb-4">
              {c.title}
            </h3>
            <p class="text-[15px] leading-[1.65] text-[#6b7280]">
              {c.body}
            </p>
          </article>
        ))}
      </div>
    ))}
  </div>
</section>


