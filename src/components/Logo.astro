---
// src/components/Logo.astro
interface Props {
  class?: string;
  "data-id"?: string;
}

const { class: className = "", "data-id": dataId } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 300 50"
  class={className}
  role="img"
  aria-label="Gewinnarchitekt Logo"
  data-id={dataId}
>
  <text
    x="10"
    y="35"
    font-family="system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
    font-size="28"
    font-weight="700"
    letter-spacing="-0.5"
  >
    <tspan fill="#16a34a">Gewinn</tspan><tspan fill="currentColor">architekt</tspan>
  </text>
</svg>
