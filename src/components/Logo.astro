---
// src/components/Logo.astro
interface Props {
  class?: string;
  width?: number;
  height?: number;
  "data-id"?: string;
}

const { class: className = "", width = 120, height = 40, "data-id": dataId } = Astro.props;
---

<img
  src="https://cdn.magicpatterns.com/design-systems/ds-3f24de7c-0892-4a55-9ee6-18f7934b304a/logos/9d68d632-a818-40a8-a6a8-c1e7af19d3d1.png"
  alt="Logo"
  class={className}
  style={`width: ${width}px; height: ${height}px; object-fit: contain;`}
  data-id={dataId}
/>
