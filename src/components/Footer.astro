---
// src/components/Footer.astro
import Logo from './Logo.astro';
---

<footer class="bg-[#1f2937] text-white">
  <div class="max-w-[1280px] mx-auto px-6 lg:px-10 py-16 lg:py-20">
    <div class="grid grid-cols-12 gap-6 lg:gap-10">
      <div class="col-span-12 lg:col-span-4">
        <Logo class="h-12 w-auto text-white" />
        <p class="mt-5 text-[13px] text-white/55 max-w-[320px] leading-[1.6]">
          Gewinnarchitektur. Pricing, Produktstrategie und
          Finanzmodellierung an der Schnittstelle, an der Marge entsteht.
        </p>
      </div>

      <div class="col-span-6 lg:col-span-3">
        <div class="label-eyebrow text-white/50 mb-4">Kontakt</div>
        <ul class="space-y-2 text-[14px] text-white/80">
          <li>Gewinnarchitekt Aschwanden</li>
          <li>CHE-233.099.319</li>
          <li>8055 Zürich</li>
          <li>+41 76 535 26 04</li>
        </ul>
      </div>

      <div class="col-span-6 lg:col-span-3">
        <div class="label-eyebrow text-white/50 mb-4">Navigation</div>
        <ul class="space-y-2 text-[14px] text-white/80">
          <li><a href="/#diagnose" class="hover:text-[#16a34a]">Diagnose</a></li>
          <li><a href="/#methodik" class="hover:text-[#16a34a]">Methodik</a></li>
          <li><a href="/#zielpublikum" class="hover:text-[#16a34a]">Zielpublikum</a></li>
          <li><a href="/leistungen" class="hover:text-[#16a34a]">Leistungen</a></li>
          <li><a href="/#kontakt" class="hover:text-[#16a34a]">Kontakt</a></li>
        </ul>
      </div>

      <div class="col-span-12 lg:col-span-2">
        <div class="label-eyebrow text-white/50 mb-4">Rechtliches</div>
        <ul class="space-y-2 text-[14px] text-white/80">
          <li><a href="#" class="hover:text-[#16a34a]">Impressum</a></li>
          <li><a href="#" class="hover:text-[#16a34a]">Datenschutz</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-14 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-[12px] text-white/50">
      <span>
        © {new Date().getFullYear()} Gewinnarchitekt · Karl Aschwanden
      </span>
      <span class="tracking-[0.2em] uppercase">
        Statik des Gewinns · Fig. 00
      </span>
    </div>
  </div>
</footer>
