---
// src/components/Zielpublikum.astro
import AudienceCard from "./AudienceCard.astro";

const audiences = [
  {
    num: "01",
    audience: "KMU",
    subtitle: "Transparenz & Stabilität",
    kern: "Profitabilität sichern und Cashflow planbar machen – Komplexität reduzieren.",
    fokus:
      "Inhabergeführte Unternehmen (5–50 Mio. CHF Umsatz) mit historisch gewachsenen Portfolios. Sie verfügen über ein Reporting, benötigen aber Klarheit über die echte Produkteprofitabilität.",
    ausschluss:
      "Startups ohne Marktreife oder Konzerne mit eigenen FP&A-Abteilungen.",
  },
  {
    num: "02",
    audience: "Scale-up",
    subtitle: "Skalierbare Erlöslogik",
    kern: "Skalierbare Preisstrukturen als Argument für anstehende Finanzierungsrunden.",
    fokus:
      "Wachstumsunternehmen mit validiertem Produkt. Founder, die ein systematisches Erlösmodell statt ad-hoc Pricing benötigen.",
    ausschluss:
      "Pre-Revenue-Setups oder punktuelle Optimierungen ohne strategisches Fundament.",
  },
  {
    num: "03",
    audience: "P&L-Verantwortliche & Partner",
    subtitle:
      "Validierte Entscheidungsgrundlagen",
    kern: "Externe Fachinstanz für belastbare Finanz- und Preismodelle.",
    fokus:
      "Management-Mitglieder (GL) und externe Partner (Fractional CFOs, Product Leader), die für kritische Weichenstellungen eine konsistente Herleitung benötigen",
    ausschluss:
      "Projekte ohne direkten Einfluss auf die Gewinn- und Verlustrechnung.",
  },
];
---

<section id="Zielpublikum" class="bg-white border-b border-[#e5e7eb]">
  <div class="max-w-[1280px] mx-auto px-6 lg:px-10 py-20 lg:py-28">
    <div class="grid grid-cols-12 gap-6 lg:gap-10 mb-16">
      <div class="col-span-12 lg:col-span-2">
        <span class="label-eyebrow">03 Zielpublikum</span>
      </div>
      <div class="col-span-12 lg:col-span-10">
        <h2
          class="font-serif-display text-[#1f2937] font-light leading-[1.05] text-[36px] sm:text-[48px] lg:text-[60px]"
        >
          Drei Profile.
          <br />
          Eine Logik der <span class="text-[#16a34a]">Profitabilität</span>.
        </h2>
      </div>
    </div>

    <div
      class="grid max-lg:snap-y max-lg:snap-proximity grid-cols-1 divide-y divide-[#e5e7eb] border-t border-[#e5e7eb] lg:grid-cols-3 lg:divide-x lg:divide-y-0"
    >
      {
        audiences.map((a) => (
          <AudienceCard
            num={a.num}
            audience={a.audience}
            subtitle={a.subtitle}
            kern={a.kern}
            fokus={a.fokus}
            ausschluss={a.ausschluss}
          />
        ))
      }
    </div>
  </div>
</section>
