---
// src/components/Zielpublikum.astro
import { Image } from 'astro:assets';
import imgConcreteJunction from '../assets/concrete-junction.png';
import imgMarktorientiert from '../assets/marktorientiert-picture.png';
---

<section id="zielpublikum" class="bg-white border-b border-[#e5e7eb]">
  <div class="max-w-[1280px] mx-auto px-6 lg:px-10 py-20 lg:py-28">
    <div class="grid grid-cols-12 gap-6 lg:gap-10 mb-16">
      <div class="col-span-12 lg:col-span-2">
        <span class="label-eyebrow">ZIELPUBLIKUM</span>
      </div>
      <div class="col-span-12 lg:col-span-10">
        <h2 class="font-serif-display text-[#1f2937] font-light leading-[1.05] text-[36px] sm:text-[48px] lg:text-[60px]">
          Für alle, die Umsatz und Marge verantworten.
        </h2>
        <p class="mt-6 max-w-[700px] text-[16px] leading-[1.6] text-[#6b7280]">
          Sie lesen den Markt sicher und entscheiden nah am Kunden. Was Ihnen fehlt, ist die quantitative Grundlage und eine nachhaltige Planung.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8 lg:gap-y-0">
      {/* Box 1: Abgrenzung */}
      <article class="bg-white border border-[#e5e7eb] rounded-[6px] overflow-hidden flex flex-col lg:grid lg:grid-rows-subgrid lg:row-span-7">
        <div class="relative w-full h-[200px] sm:h-[240px] bg-[#f3f4f6] border-b border-[#e5e7eb] overflow-hidden card-image-strip">
          <Image
            src={imgConcreteJunction}
            alt="Sichtbeton-Konstruktion mit sich kreuzenden Wänden"
            widths={[400, 600, 800]}
            sizes="(max-width: 1024px) 95vw, 600px"
            class="w-full h-full object-cover object-center block filter grayscale contrast-[1.03]"
          />
        </div>
        <div class="p-8 lg:p-10 flex flex-col flex-1 lg:grid lg:grid-rows-subgrid lg:row-span-6">
          <span class="label-eyebrow mb-6 block">Abgrenzung</span>
          <h3 class="font-serif-display text-[#1f2937] text-[22px] lg:text-[24px] leading-snug mb-6">
            Wofür andere die bessere Wahl sind
          </h3>
          <ul class="flex-1 lg:grid lg:grid-rows-subgrid lg:row-span-4">
            <li class="flex items-start text-[15px] leading-[1.7] text-[#6b7280] mb-4 last:mb-0">
              <span class="mr-3 text-[#9ca3af] mt-[2px]">–</span>
              <span>
                <span class="font-bold text-[#1f2937] block">Buchhaltung und Jahresabschluss:</span>
                Dafür ist Ihr Treuhänder der richtige Partner.
              </span>
            </li>
            <li class="flex items-start text-[15px] leading-[1.7] text-[#6b7280] mb-4 last:mb-0">
              <span class="mr-3 text-[#9ca3af] mt-[2px]">–</span>
              <span>
                <span class="font-bold text-[#1f2937] block">Operativer Vertrieb:</span>
                Ihr Verkaufsteam kennt Ihre Kunden am besten.
              </span>
            </li>
            <li class="flex items-start text-[15px] leading-[1.7] text-[#6b7280] mb-4 last:mb-0">
              <span class="mr-3 text-[#9ca3af] mt-[2px]">–</span>
              <span>
                <span class="font-bold text-[#1f2937] block">Social Media und Reichweite:</span>
                Dafür gibt es spezialisierte Agenturen.
              </span>
            </li>
            <li class="flex items-start text-[15px] leading-[1.7] text-[#6b7280] mb-4 last:mb-0">
              <span class="mr-3 text-[#9ca3af] mt-[2px]">–</span>
              <span>
                <span class="font-bold text-[#1f2937] block">Pauschale Preiserhöhungen:</span>
                Dafür braucht es keinen Pricing-Spezialisten.
              </span>
            </li>
          </ul>
        </div>
      </article>

      {/* Box 2: Mehrwert */}
      <article class="bg-white border border-[#e5e7eb] rounded-[6px] overflow-hidden flex flex-col lg:grid lg:grid-rows-subgrid lg:row-span-7">
        <div class="relative w-full h-[200px] sm:h-[240px] bg-[#f3f4f6] border-b border-[#e5e7eb] overflow-hidden card-image-strip">
          <Image
            src={imgMarktorientiert}
            alt="Blick durch ein Betonfenster auf eine weite, geordnete Anlage"
            widths={[400, 600, 800]}
            sizes="(max-width: 1024px) 95vw, 600px"
            class="w-full h-full object-cover object-center block filter grayscale contrast-[1.03]"
          />
        </div>
        <div class="p-8 lg:p-10 flex flex-col flex-1 lg:grid lg:grid-rows-subgrid lg:row-span-6">
          <span class="label-eyebrow mb-6 block">Mehrwert</span>
          <h3 class="font-serif-display text-[#1f2937] text-[22px] lg:text-[24px] leading-snug mb-6">
            Wo ich Ihnen helfe
          </h3>
          <ul class="flex-1 lg:grid lg:grid-rows-subgrid lg:row-span-4">
            <li class="flex items-start text-[15px] leading-[1.7] text-[#6b7280] mb-4 last:mb-0">
              <span class="mr-3 text-[#9ca3af] mt-[2px]">–</span>
              <span><span class="font-bold text-[#1f2937]">Transparenz:</span> Sie wissen, welche Angebote, Kunden und Produkte wirklich Geld verdienen, und planen auf dieser Basis.</span>
            </li>
            <li class="flex items-start text-[15px] leading-[1.7] text-[#6b7280] mb-4 last:mb-0">
              <span class="mr-3 text-[#9ca3af] mt-[2px]">–</span>
              <span><span class="font-bold text-[#1f2937]">Verkaufssicherheit:</span> Ihr Team verkauft mit klarer Preislogik, überzeugenden Argumenten und verbindlichen Rabattregeln.</span>
            </li>
            <li class="flex items-start text-[15px] leading-[1.7] text-[#6b7280] mb-4 last:mb-0">
              <span class="mr-3 text-[#9ca3af] mt-[2px]">–</span>
              <span><span class="font-bold text-[#1f2937]">Mehr Gewinn pro Abschluss:</span> Sie holen mehr aus der bestehenden Nachfrage heraus, mit höheren Abschlussquoten und besseren Margen.</span>
            </li>
            <li class="flex items-start text-[15px] leading-[1.7] text-[#6b7280] mb-4 last:mb-0">
              <span class="mr-3 text-[#9ca3af] mt-[2px]">–</span>
              <span><span class="font-bold text-[#1f2937]">Planungssicherheit:</span> Jede Preisänderung ist vorher durchgerechnet, mit Szenarien, Sensitivitäten und den Auswirkungen auf Volumen und Marge.</span>
            </li>
          </ul>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .card-image-strip img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center !important;
    display: block !important;
  }
</style>
