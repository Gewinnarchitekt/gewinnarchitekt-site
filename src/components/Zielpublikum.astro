---
// src/components/Zielpublikum.astro
import { Image } from 'astro:assets';
import imgConcreteJunction from '../assets/concrete-junction.png';
import imgMarktorientiert from '../assets/marktorientiert-picture.png';
---

<section id="zielpublikum" class="bg-white border-b border-[#e5e7eb]">
  <div class="max-w-[1280px] mx-auto px-6 lg:px-10 py-20 lg:py-28">
    <div class="grid grid-cols-12 gap-6 lg:gap-10 mb-16">
      <div class="col-span-12 lg:col-span-2">
        <span class="label-eyebrow">ZIELPUBLIKUM</span>
      </div>
      <div class="col-span-12 lg:col-span-10">
        <h2 class="font-serif-display text-[#1f2937] font-light leading-[1.05] text-[36px] sm:text-[48px] lg:text-[60px]">
          Für alle, die Umsatz und Marge verantworten.
        </h2>
        <p class="mt-6 max-w-[700px] text-[16px] leading-[1.6] text-[#6b7280]">
          Sie lesen den Markt sicher und entscheiden nah am Kunden. Was Ihnen fehlt, ist die quantitative Grundlage und eine nachhaltige Planung.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8">
      {/* Box 1: Ausschluss */}
      <article class="bg-white border border-[#e5e7eb] rounded-[6px] overflow-hidden flex flex-col">
        <div class="relative w-full h-[200px] sm:h-[240px] bg-[#f3f4f6] border-b border-[#e5e7eb] overflow-hidden card-image-strip">
          <Image
            src={imgConcreteJunction}
            alt="Sichtbeton-Konstruktion mit sich kreuzenden Wänden"
            widths={[400, 600, 800]}
            sizes="(max-width: 1024px) 95vw, 600px"
            class="w-full h-full object-cover object-center block filter grayscale contrast-[1.03]"
          />
        </div>
        <div class="p-8 lg:p-10 flex flex-col flex-1">
          <span class="label-eyebrow mb-6 block">Ausschluss</span>
          <h3 class="font-serif-display text-[#1f2937] text-[22px] lg:text-[24px] leading-snug mb-6">
            Was Sie nicht erwarten sollten
          </h3>
          <ul class="space-y-4 flex-1">
            <li class="flex items-start text-[15px] leading-[1.7] text-[#6b7280]">
              <span class="mr-3 text-[#9ca3af] mt-[2px]">–</span>
              <span><span class="font-bold text-[#1f2937]">Buchhaltung und Jahresabschluss:</span> Ich mache keine Abschlüsse, sondern zeige, welche Zahlen für die Zukunft zählen.</span>
            </li>
            <li class="flex items-start text-[15px] leading-[1.7] text-[#6b7280]">
              <span class="mr-3 text-[#9ca3af] mt-[2px]">–</span>
              <span><span class="font-bold text-[#1f2937]">Pauschale Preiserhöhungen:</span> Ich erhöhe nicht einfach die Preise, sondern zeige, wo tatsächliches Gewinnpotenzial verborgen liegt.</span>
            </li>
            <li class="flex items-start text-[15px] leading-[1.7] text-[#6b7280]">
              <span class="mr-3 text-[#9ca3af] mt-[2px]">–</span>
              <span><span class="font-bold text-[#1f2937]">Operativer Vertrieb:</span> Ich verkaufe nicht, sondern liefere die Grundlagen, damit Ihr Team profitabler verkaufen kann.</span>
            </li>
            <li class="flex items-start text-[15px] leading-[1.7] text-[#6b7280]">
              <span class="mr-3 text-[#9ca3af] mt-[2px]">–</span>
              <span><span class="font-bold text-[#1f2937]">Social-Media-Kampagnen und Reichweite:</span> Ich generiere keine Klicks, sondern helfe, Abschlussquote und Marge zu verbessern.</span>
            </li>
          </ul>
        </div>
      </article>

      {/* Box 2: Mehrwert */}
      <article class="bg-white border border-[#e5e7eb] rounded-[6px] overflow-hidden flex flex-col">
        <div class="relative w-full h-[200px] sm:h-[240px] bg-[#f3f4f6] border-b border-[#e5e7eb] overflow-hidden card-image-strip">
          <Image
            src={imgMarktorientiert}
            alt="Blick durch ein Betonfenster auf eine weite, geordnete Anlage"
            widths={[400, 600, 800]}
            sizes="(max-width: 1024px) 95vw, 600px"
            class="w-full h-full object-cover object-center block filter grayscale contrast-[1.03]"
          />
        </div>
        <div class="p-8 lg:p-10 flex flex-col flex-1">
          <span class="label-eyebrow mb-6 block">Mehrwert</span>
          <h3 class="font-serif-display text-[#1f2937] text-[22px] lg:text-[24px] leading-snug mb-6">
            Was wir gemeinsam erreichen können
          </h3>
          <ul class="space-y-4 flex-1">
            <li class="flex items-start text-[15px] leading-[1.7] text-[#6b7280]">
              <span class="mr-3 text-[#9ca3af] mt-[2px]">–</span>
              <span><span class="font-bold text-[#1f2937]">Transparenz:</span> Sie wissen genau, welches die profitabelsten Kunden und Angebote sind.</span>
            </li>
            <li class="flex items-start text-[15px] leading-[1.7] text-[#6b7280]">
              <span class="mr-3 text-[#9ca3af] mt-[2px]">–</span>
              <span><span class="font-bold text-[#1f2937]">Verkaufsstarke Angebote:</span> Sie gewinnen mehr Abschlüsse, weil Ihre Angebote bestens auf die Kunden ausgerichtet sind.</span>
            </li>
            <li class="flex items-start text-[15px] leading-[1.7] text-[#6b7280]">
              <span class="mr-3 text-[#9ca3af] mt-[2px]">–</span>
              <span><span class="font-bold text-[#1f2937]">Planungssicherheit für Investitionen:</span> Sie entscheiden aufgrund  fundierter Szenarien und klarer Entscheidungsgrundlagen.</span>
            </li>
            <li class="flex items-start text-[15px] leading-[1.7] text-[#6b7280]">
              <span class="mr-3 text-[#9ca3af] mt-[2px]">–</span>
              <span><span class="font-bold text-[#1f2937]">Mehr Gewinn:</span> Sie erzielen mehr Gewinn dank eines starken Preismodells, optimierter Preispunkte und sauberer Rabattlogik.</span>
            </li>
          </ul>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .card-image-strip img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center !important;
    display: block !important;
  }
</style>
