---
// src/components/Zielpublikum.astro

const cards = [
  {
    title: "Kundenorientiert",
    body1: "Sie führen kommerziell als Head of Sales oder mit Umsatzverantwortung. Sie kennen die Einwände und die individuellen Beschwerden. Was Ihnen fehlt, sind belegbare Informationen: Tatsächliche Vergleichsinformationen und eine Preislogik, welche die Aufmerksamkeit auf den tatsächlichen Kundenwert lenkt.",
      },
  {
    title: "Marktorientiert",
    body1: "Sie führen Produkt oder Strategie: in der Geschäftsleitung, mit P&L-Verantwortung oder als Fractional Product Leader. Den Markt und den Wettbewerb lesen Sie sicher. Was Ihnen fehlt, ist die quantitative Herleitung, die Ihre Positionierung in belastbare Preise und Entscheidungen übersetzt.",
    
  },
  {
    title: "Finanzorientiert",
    body1: "Sie verantworten die Zahlen: als CFO oder im CFO-as-a-Service-Mandat. Die Herleitung beherrschen Sie. Was Sie suchen, ist die marktseitige Datengrundlage, damit Ihre Modelle auf Evidenz stehen statt auf Annahmen.",
    
  },
];
---

<section id="zielpublikum" class="bg-white border-b border-[#e5e7eb]">
  <div class="max-w-[1280px] mx-auto px-6 lg:px-10 py-20 lg:py-28">
    <div class="grid grid-cols-12 gap-6 lg:gap-10 mb-16">
      <div class="col-span-12 lg:col-span-2">
        <span class="label-eyebrow">03 Zielpublikum</span>
      </div>
      <div class="col-span-12 lg:col-span-10">
        <h2
          class="font-serif-display text-[#1f2937] font-light leading-[1.05] text-[36px] sm:text-[48px] lg:text-[60px]"
        >
          Drei Perspektiven, alle mit dem <span class="text-[#16a34a]">gleichen Ziel</span>.
        </h2>
        <p class="mt-6 max-w-[700px] text-[16px] leading-[1.6] text-[#6b7280]">
          Die meisten sind in einer dieser Perspektiven zu Hause und brauchen die anderen beiden, um wirklich belastbar entscheiden zu können..
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
      {
        cards.map((c) => (
          <article class="bg-white border border-[#e5e7eb] rounded-[6px] p-8 lg:p-10 flex flex-col">
            <h3 class="font-serif-display text-[#1f2937] text-[22px] lg:text-[24px] leading-tight mb-4">
              {c.title}
            </h3>
            <p class="text-[15px] leading-[1.65] text-[#6b7280]">
              {c.body1}<br />{c.body2}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
