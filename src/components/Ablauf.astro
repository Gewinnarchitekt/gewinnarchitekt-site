---
// src/components/Ablauf.astro
const profitSteps = [
  {
    letter: "P",
    title: "Portfolio",
    question: "Wo verdienen Sie Geld, und wo verlieren Sie es?",
    keywords: "Deckungsbeiträge nach Produkt, Kunde und Transaktion · Gewinntreiberbaum · Preiswasserfall",
  },
  {
    letter: "R",
    title: "Recherche",
    question: "Was sind Ihre Kunden wirklich bereit zu zahlen?",
    keywords: "Kundeninterviews · Zahlungsbereitschaft · Wettbewerbsvergleiche",
  },
  {
    letter: "O",
    title: "Offer",
    question: "Angebote, die ihren Preis rechtfertigen.",
    keywords: "Pakete · Preismetrik · Preisniveau · Rabattlogik",
  },
  {
    letter: "F",
    title: "Finanzplanung",
    question: "Chancen und Risiken bewerten können.",
    keywords: "Business Cases · Szenarien · Sensitivitäten",
  },
  {
    letter: "I",
    title: "Implementierung",
    question: "Vom Konzept in den Markt.",
    keywords: "Massnahmenpläne · Kommunikationskonzepte · Strukturen und Prozesse",
  },
  {
    letter: "T",
    title: "Tracking",
    question: "Kontinuierlich die Kontrolle behalten.",
    keywords: "Steuerungscockpit · Kennzahlen · Abweichungsanalyse",
  },
];
---

<section class="bg-[#f9fafb] border-b border-[#e5e7eb]">
  <div class="max-w-[1280px] mx-auto px-6 lg:px-10 py-20 lg:py-28">
    <div class="grid grid-cols-12 gap-6 lg:gap-10 mb-16">
      <div class="col-span-12 lg:col-span-2">
        <span class="label-eyebrow">Ablauf</span>
      </div>
      <div class="col-span-12 lg:col-span-10">
        <h2 class="font-serif-display text-[#1f2937] font-light leading-[1.05] text-[36px] sm:text-[48px] lg:text-[60px]">
          Das P·R·O·F·I·T Framework
        </h2>
        <p class="mt-6 max-w-[700px] text-[16px] leading-[1.6] text-[#6b7280]">
          Sechs Module, einzeln oder kombiniert buchbar. Jedes mit einem klar definierten Ergebnis.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {profitSteps.map((step) => (
        <article class="bg-white border border-[#e5e7eb] rounded-[6px] p-8 lg:p-10 flex flex-col">
          <span class="font-serif-display text-[#16a34a] text-[36px] lg:text-[42px] font-light leading-none mb-5 block">
            {step.letter}
          </span>
          <h3 class="font-serif-display text-[#1f2937] text-[20px] lg:text-[22px] font-semibold leading-tight mb-3">
            {step.title}
          </h3>
          <p class="text-[15px] lg:text-[16px] leading-[1.6] text-[#1f2937] mb-6">
            {step.question}
          </p>
          <p class="text-[13px] leading-[1.55] text-[#6b7280] mt-auto pt-4 border-t border-[#e5e7eb]">
            {step.keywords}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
