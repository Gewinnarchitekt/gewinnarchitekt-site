---
// src/components/Problems.astro

const groups = [
  {
    num: 'A',
    title: 'Fehlkonstruktion in der Preislogik',
    stat: '> 20%',
    statLabel: 'des möglichen Umsatzes entgehen ohne optimiertes Angebot.',
    source: 'Simon-Kucher',
    points: [
      'Einheitsangebote ignorieren unterschiedliche Kundensegmente.',
      'Die Preislogik ist nicht auf das Kundenverhalten abgestimmt.',
      'Intern kalkulierte Angebote spiegeln nicht den Kundenwert.',
      'Der Mehrwert für den Kunden wird nicht klar kommuniziert.'
    ]
  },
  {
    num: 'B',
    title: 'Reibungsverluste in der Umsetzung',
    stat: '66%',
    statLabel: 'des Potenzials von Preisanpassungen geht durch falsche Prozesse verloren.',
    source: 'McKinsey',
    points: [
      'Daten zum Kundenverhalten werden nicht ausreichend genutzt.',
      'Es fehlen Ressourcen für die Identifikation von Umsatzpotenzial.',
      'Mangelnde Expertise im Bereich Pricing & Monetarisierung.',
      'Datensilos behindern den Informationsfluss.'
    ]
  },
  {
    num: 'C',
    title: 'Strukturelle Lücken in der Planung',
    stat: '30%',
    statLabel: 'der wichtigen Entscheidungen verfehlen den besten Preis.',
    source: 'McKinsey',
    points: [
      'Kundenbedürfnisse werden zu spät berücksichtigt.',
      'Innovationen werden am Markt vorbei entwickelt.',
      'Priorisierung ist nicht auf monetäres Wachstum ausgerichtet.',
      'Es fehlt eine langfristige Perspektive.'
    ]
  }
];
---

<section id="herausforderungen" class="bg-white border-b border-[#e5e7eb]">
  <div class="max-w-[1280px] mx-auto px-6 lg:px-10 py-20 lg:py-28">
    <div class="grid grid-cols-12 gap-6 lg:gap-10 mb-16">
      <div class="col-span-12 lg:col-span-2">
        <span class="label-eyebrow">01 Diagnose</span>
      </div>
      <div class="col-span-12 lg:col-span-10">
        <h2 class="font-serif-display text-[#1f2937] font-light leading-[1.05] text-[36px] sm:text-[48px] lg:text-[60px]">
          Gewinne optimieren heisst Schwachstellen <span class="text-[#16a34a]">eliminieren</span>.
        </h2>
        <p class="mt-6 max-w-[700px] text-[16px] leading-[1.6] text-[#6b7280]">
          Oft versickert Marge dort, where Produktstrategie, Finanzdaten und
          Kundenverständnis nicht optimal aufeinander abgestimmt sind. Die
          Konsequenzen lassen sich in den folgenden drei Bereichen
          beobachten.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 border-t border-[#1f2937]">
      {groups.map((g, i) => (
        <div class={`p-8 lg:p-10 border-b border-[#e5e7eb] ${i < 2 ? 'lg:border-r' : ''} lg:border-b-0 ${i < groups.length - 1 ? 'border-b' : ''}`}>
          <div class="flex items-baseline justify-between mb-8">
            <span class="font-serif-display text-[#16a34a] text-[28px]">{g.num}</span>
            <span class="text-[10px] tracking-[0.2em] uppercase text-[#6b7280]">Quelle: {g.source}</span>
          </div>

          <h3 class="font-serif-display text-[#1f2937] text-[26px] leading-tight mb-6">
            {g.title}
          </h3>

          <div class="border-l-2 border-[#16a34a] pl-4 mb-8">
            <div class="font-serif-display text-[#1f2937] text-[40px] leading-none">
              {g.stat}
            </div>
            <p class="text-[13px] text-[#6b7280] mt-2 leading-snug">
              {g.statLabel}
            </p>
          </div>

          <ul class="space-y-3">
            {g.points.map((p) => (
              <li class="flex gap-3 text-[14px] text-[#1f2937] leading-[1.55]">
                <span class="inline-block w-1.5 h-1.5 bg-[#16a34a] rounded-full mt-[7px] shrink-0" aria-hidden="true"></span>
                <span>{p}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
